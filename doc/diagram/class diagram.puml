@startuml 03-class-diagram
title AcadOS - Class Diagram (Domain + Service + Repository + Design Patterns)\nอ้างอิง Implement Plan v6 §6, §7, §8, §10, §14, §16, §17 · field ที่เอกสารไม่ระบุ ใช้ชื่อตาม database.md / Sequence Diagram
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 50

' =====================================================================
' 1. Domain Entities (§6.1 · 16 Entities)
' =====================================================================
package "domain.entity" {
  class User {
    - id: Long
    - universityId: String
    - email: String
    - passwordHash: String
    - role: UserRole
  }
  class Student {
    - id: Long
    - user: User
    - fullName: String
  }
  class Teacher {
    - id: Long
    - user: User
    - fullName: String
  }
  class Course {
    - id: Long
    - courseCode: String
    - title: String
    - weeklyHours: int
  }
  class Section {
    - id: Long
    - course: Course
    - sectionNumber: int
    - capacity: int
    - status: SectionStatus
    - state: SectionState
    + cancel(): void
    + setState(state: SectionState): void
    + getState(): SectionState
  }
  class Room {
    - id: Long
    - roomNumber: String
    - building: String
    - floor: int
    - capacity: int
    - isAvailable: boolean
  }
  class TimeSlot {
    - id: Long
    - dayOfWeek: DayOfWeek
    - startTime: LocalTime
    - endTime: LocalTime
  }
  class Schedule {
    - id: Long
    - section: Section
    - teacher: Teacher
    - room: Room
    - timeSlot: TimeSlot
    - status: ScheduleStatus
  }
  class Registration {
    - id: Long
    - student: Student
    - section: Section
    - course: Course
    - registeredAt: LocalDateTime
  }
  class TeacherQualification {
    - id: Long
    - teacher: Teacher
    - course: Course
  }
  class TeacherPreference {
    - id: Long
    - teacher: Teacher
    - course: Course
    - priority: int
  }
  class TeacherAvailability {
    - id: Long
    - teacher: Teacher
    - timeSlot: TimeSlot
    - isAvailable: boolean
  }
  class TeacherSwapRequest {
    - id: Long
    - requestingTeacher: Teacher
    - requestingSchedule: Schedule
    - targetTeacher: Teacher
    - targetSchedule: Schedule
    - status: SwapStatus
    - createdAt: LocalDateTime
    - respondedAt: LocalDateTime
    - reviewedAt: LocalDateTime
    + accept(): void
    + reject(): void
    + approve(): void
    + cancel(): void
  }
  class Notification {
    - id: Long
    - user: User
    - title: String
    - message: String
    - type: NotificationType
    - isRead: boolean
    - createdAt: LocalDateTime
    + markAsRead(): void
  }
  class AcademicEvent {
    - id: Long
    - eventName: String
    - eventType: AcademicEventType
    - startDate: LocalDate
    - endDate: LocalDate
  }
  class PublicHoliday {
    - id: Long
    - date: LocalDate
    - name: String
    - description: String
  }
}

' =====================================================================
' 2. Enums (§7 domain.enums + ค่าที่เอกสารระบุใน §6.1, §14.5)
' =====================================================================
package "domain.enums" {
  enum UserRole {
    ADMIN
    TEACHER
    STUDENT
  }
  enum SectionStatus {
    ACTIVE
    CANCELLED
  }
  enum ScheduleStatus {
    DRAFT
    PUBLISHED
  }
  enum SwapStatus {
    PENDING
    ACCEPTED
    REJECTED
    APPROVED
    CANCELLED
  }
  enum AcademicEventType {
    SEMESTER_START
    SEMESTER_END
    REGISTRATION_PERIOD
    MIDTERM_EXAM
    FINAL_EXAM
  }
  enum NotificationType {
    REGISTRATION_SUCCESS
    REGISTRATION_WITHDRAWN
    SCHEDULE_CHANGED
    SWAP_REQUESTED
    SWAP_RESPONDED
    SWAP_APPROVED
    SWAP_REJECTED
    SWAP_CANCELLED
    SECTION_CANCELLED
    CONFLICT_DETECTED
  }
}

' =====================================================================
' 3. Service Layer (§10.2 + Service ใหม่ใน §7 · method ของ Service ใหม่ดึงจาก §16 / Userflow)
'    DIP: Service ทุกตัวเป็น Interface · โค้ดจริงอยู่ที่ service/impl/XxxServiceImpl
' =====================================================================
package "service" {
  interface RegistrationService {
    + register(): Registration
    + withdraw(): void
    + checkDuplicate(): boolean
    + checkConflict(): boolean
  }
  interface SchedulingService <<Orchestrator>> {
    + generateSchedule(): void
    + publishSchedule(): void
    + discardDraft(): void
  }
  interface TeacherSwapService {
    + createSwapRequest(): TeacherSwapRequest
    + respondSwap(): void
    + approveSwap(): void
    + rejectSwap(): void
    + cancelSwap(): void
  }
  interface SectionCancellationService {
    + cancelSection(): void
  }
  interface NotificationService {
    + sendNotification(): void
    + getNotifications(): List<Notification>
    + markAsRead(): void
  }
  interface HolidayService {
    + getHolidays(): List<PublicHoliday>
    + syncHolidays(): void
  }
  interface CourseService {
    + getCourses(pageable: Pageable): Page<Course>
    + getCourse(id: Long): Course
    + createCourse(req: CourseRequest): Course
    + updateCourse(id: Long, req: CourseRequest): Course
    + deleteCourse(id: Long): void
  }
  interface RoomService {
    + getRooms(): List<Room>
    + getRoom(id: Long): Room
    + createRoom(req: RoomRequest): Room
    + updateRoom(id: Long, req: RoomRequest): Room
    + deleteRoom(id: Long): void
  }
  interface UserService {
    + getUsers(pageable: Pageable): Page<User>
    + getUser(id: Long): User
    + createUser(req: UserCreateRequest): User
    + updateUser(id: Long, req: UserUpdateRequest): User
    + deleteUser(id: Long): void
  }
  interface SectionService {
    + getSections(courseId: Long): List<Section>
    + getSection(id: Long): Section
    + createSection(req: SectionRequest): Section
    + updateSection(id: Long, req: SectionRequest): Section
  }
  interface TeacherAssignmentService {
    + assignTeacher(sectionId: Long, teacherId: Long): void
  }
  interface TeacherAvailabilityService {
    + getMyAvailabilities(): List<TeacherAvailability>
    + saveAvailability(req: AvailabilityRequest): TeacherAvailability
    + deleteAvailability(id: Long): void
    + getMyQualifications(): List<TeacherQualification>
  }
  interface AcademicEventService {
    + getEvents(): List<AcademicEvent>
    + createEvent(req: AcademicEventRequest): AcademicEvent
    + updateEvent(id: Long, req: AcademicEventRequest): AcademicEvent
    + deleteEvent(id: Long): void
  }
  note bottom of UserService
    method ของ Course, Room, User, Section, TeacherAssignment,
    TeacherAvailability, AcademicEvent Service
    ดึงจาก §16 และ Userflow A01, A02, A09, A11-A13, T02-T04
    (§10.2 ยังไม่ระบุ)
  end note
  note bottom of RegistrationService
    DIP (ข้อ 4 D ของอาจารย์): Controller และ Service อื่น
    พึ่งพา Interface เหล่านี้ ไม่ใช่คลาสจริง
    ทุก Interface มีคลาส XxxServiceImpl ใน service/impl/
    ที่ implements และรับ dependency ผ่าน Constructor Injection
  end note
}

' =====================================================================
' 4. Repository Layer (§7 repository · Repository Pattern §17.1)
' =====================================================================
package "repository" <<Repository>> {
  interface UserRepository
  interface StudentRepository
  interface TeacherRepository
  interface CourseRepository
  interface SectionRepository
  interface RoomRepository
  interface TimeSlotRepository
  interface ScheduleRepository
  interface RegistrationRepository
  interface TeacherQualificationRepository
  interface TeacherPreferenceRepository
  interface TeacherAvailabilityRepository
  interface TeacherSwapRequestRepository
  interface NotificationRepository
  interface AcademicEventRepository
  interface PublicHolidayRepository
  note bottom of PublicHolidayRepository
    ทุก Repository extends JpaRepository<Entity, Long>
    (Spring Data JPA) · 1 Repository ต่อ 1 Entity
    6 ตัวที่ยังไม่มีใน §7: TimeSlot, TeacherQualification,
    TeacherPreference, TeacherAvailability,
    TeacherSwapRequest, Notification
  end note
}

' =====================================================================
' 5. Exception (§5.1 ข้อ 4, §7 exception, §10.3)
' =====================================================================
package "exception" {
  class GlobalExceptionHandler <<@RestControllerAdvice>> {
    + handleBusinessRuleException(ex: BusinessRuleException, req: HttpServletRequest): ResponseEntity<ErrorResponse>
    + handleResourceNotFoundException(ex: ResourceNotFoundException, req: HttpServletRequest): ResponseEntity<ErrorResponse>
    + handleResponseStatusException(ex: ResponseStatusException, req: HttpServletRequest): ResponseEntity<ErrorResponse>
    + handleValidationException(ex: MethodArgumentNotValidException, req: HttpServletRequest): ResponseEntity<ErrorResponse>
    + handleAccessDeniedException(ex: AccessDeniedException, req: HttpServletRequest): ResponseEntity<ErrorResponse>
    + handleBadCredentialsException(ex: BadCredentialsException, req: HttpServletRequest): ResponseEntity<ErrorResponse>
    + handleIllegalArgumentException(ex: IllegalArgumentException, req: HttpServletRequest): ResponseEntity<ErrorResponse>
    + handleGenericException(ex: Exception, req: HttpServletRequest): ResponseEntity<ErrorResponse>
  }
  class BusinessRuleException
  class ResourceNotFoundException
  class ErrorResponse {
    - timestamp: LocalDateTime
    - status: int
    - error: String
    - message: String
    - path: String
    - details: List<String>
  }
}
class RuntimeException <<java.lang>>

' =====================================================================
' 6. Scheduling Engine + Strategy (§10.3, §12, §17.2 · Sequence 05)
' =====================================================================
package "scheduling" {
  class ConstraintEvaluator {
    + validate(candidate: Candidate): ValidationResult
  }
  class ScheduleSelector {
    + selectBest(candidates: List<Candidate>): Candidate
  }
  class Candidate {
    - section: Section
    - teacher: Teacher
    - room: Room
    - timeSlots: List<TimeSlot>
    - score: int
  }
  class ValidationResult {
    - passed: boolean
    - reason: String
  }
  note bottom of Candidate
    1 Candidate = ทุกคาบของ 1 Section (Sequence 05)
    อาจารย์ x ห้อง x ชุด TimeSlot
    ผู้ชนะถูกบันทึกเป็น Schedule สถานะ DRAFT คาบละ 1 แถว
  end note
  note bottom of ValidationResult
    reason = Hard Constraint ข้อที่ไม่ผ่าน (§12.3)
    ใช้สรุปสาเหตุหลักเมื่อจัด Section ไม่ได้ (D28)
  end note
}
package "strategy" <<Strategy>> {
  interface ScoringStrategy {
    + calculateScore(candidate: Candidate): int
  }
  class PreferenceScoreStrategy {
    + calculateScore(candidate: Candidate): int
  }
  class WorkloadScoreStrategy {
    + calculateScore(candidate: Candidate): int
  }
  class RoomSuitabilityScoreStrategy {
    + calculateScore(candidate: Candidate): int
  }
  note bottom of RoomSuitabilityScoreStrategy : เงื่อนไข = TBA (§12.4, §28)
}

' =====================================================================
' 7. State Pattern (§10.3, §17.2)
' =====================================================================
package "state" <<State>> {
  interface SectionState {
    + cancel(): void
  }
  class ActiveSectionState {
    + cancel(): void
  }
  class CancelledSectionState {
    + cancel(): void
  }
}

' =====================================================================
' 8. Notification Strategy (§10.3, §14.6, §17.2)
' =====================================================================
package "notification.strategy" <<Strategy>> {
  interface NotificationStrategy {
    + send(): void
  }
  class InAppNotificationStrategy {
    + send(): void
  }
  class EmailNotificationStrategy {
    + send(): void
  }
}

' =====================================================================
' 9. Observer Pattern (§7 observer, §17.2)
' =====================================================================
package "observer" <<Observer>> {
  interface ScheduleChangeSubject {
    + attach(observer: ScheduleChangeObserver): void
    + detach(observer: ScheduleChangeObserver): void
    + notifyObservers(sections: List<Section>): void
  }
  interface ScheduleChangeObserver {
    + onScheduleChanged(sections: List<Section>): void
  }
  class ScheduleChangePublisher {
    - observers: List<ScheduleChangeObserver>
    + attach(observer: ScheduleChangeObserver): void
    + detach(observer: ScheduleChangeObserver): void
    + notifyObservers(sections: List<Section>): void
  }
}

' =====================================================================
' 10. Adapter Pattern (§10.3, §14.7, §17.2)
' =====================================================================
package "holiday" <<Adapter>> {
  interface HolidayProvider {
    + fetchHolidays(): List<PublicHoliday>
  }
  class ExternalHolidayAdapter {
    + fetchHolidays(): List<PublicHoliday>
  }
}

' =====================================================================
' Domain relationships (§6.1, §6.2)
' =====================================================================
User "1" -- "0..1" Student : student profile
User "1" -- "0..1" Teacher : teacher profile
User "1" -- "0..*" Notification : receives
Course "1" -- "0..*" Section : offers
Section "1" *-- "0..*" Schedule : has
Schedule "0..*" --> "0..1" Room : assigned room
Schedule "0..*" --> "1" Teacher : assigned teacher
Schedule "0..*" --> "1" TimeSlot : scheduled at
Student "1" -- "0..*" Registration
Section "1" -- "0..*" Registration
Course "1" -- "0..*" Registration : BR-04
Teacher "1" -- "0..*" TeacherQualification
Course "1" -- "0..*" TeacherQualification
Teacher "1" -- "0..*" TeacherPreference
Course "1" -- "0..*" TeacherPreference
Teacher "1" -- "0..*" TeacherAvailability
TimeSlot "1" -- "0..*" TeacherAvailability
TeacherSwapRequest "0..*" --> "1" Teacher : requestingTeacher (Snapshot A)
TeacherSwapRequest "0..*" --> "1" Teacher : targetTeacher (Snapshot B)
TeacherSwapRequest "0..*" --> "0..1" Schedule : requestingSchedule (SET NULL)
TeacherSwapRequest "0..*" --> "0..1" Schedule : targetSchedule (SET NULL)

User ..> UserRole
Section ..> SectionStatus
Schedule ..> ScheduleStatus
TeacherSwapRequest ..> SwapStatus
AcademicEvent ..> AcademicEventType
Notification ..> NotificationType

' =====================================================================
' Pattern relationships
' =====================================================================
Section o--> SectionState : state
SectionState <|.. ActiveSectionState
SectionState <|.. CancelledSectionState

ScoringStrategy <|.. PreferenceScoreStrategy
ScoringStrategy <|.. WorkloadScoreStrategy
ScoringStrategy <|.. RoomSuitabilityScoreStrategy

NotificationStrategy <|.. InAppNotificationStrategy
NotificationStrategy <|.. EmailNotificationStrategy

ScheduleChangeSubject <|.. ScheduleChangePublisher
ScheduleChangePublisher o--> ScheduleChangeObserver : observers
ScheduleChangeObserver <|-- NotificationService : extends (Impl รับ onScheduleChanged)

HolidayProvider <|.. ExternalHolidayAdapter

' =====================================================================
' Scheduling Engine relationships (Sequence 05)
' =====================================================================
Candidate --> "1" Section
Candidate --> "1" Teacher
Candidate --> "1" Room
Candidate --> "1..*" TimeSlot
ConstraintEvaluator ..> Candidate : validates
ConstraintEvaluator ..> ValidationResult : returns
ScheduleSelector ..> Candidate : ranks
ScoringStrategy ..> Candidate : scores
SchedulingService ..> Candidate : builds

' =====================================================================
' Exception relationships (§5.1 ข้อ 4)
' =====================================================================
RuntimeException <|-- BusinessRuleException
RuntimeException <|-- ResourceNotFoundException
GlobalExceptionHandler ..> BusinessRuleException : handles
GlobalExceptionHandler ..> ResourceNotFoundException : handles
GlobalExceptionHandler ..> ErrorResponse : creates
note right of GlobalExceptionHandler
  Service ทุกตัว throw BusinessRuleException
  (ผิด Business Rule) / ResourceNotFoundException (ไม่พบข้อมูล)
  ส่งต่อมาที่ GlobalExceptionHandler → ErrorResponse
end note

