@startuml AcadOS_ER_Diagram

title AcadOS v4 - ER Diagram
left to right direction
hide circle

legend right
  * = NOT NULL (columns without * are nullable)
  PK = Primary Key / FK = Foreign Key / UK = Unique
  (CASCADE) / (RESTRICT) on a relationship = ON DELETE rule of the FK
  UNIQUE and INDEX lines in notes are composite constraints
  PK, UNIQUE and FK columns are indexed automatically by MySQL InnoDB
endlegend

entity users {
  * id : BIGINT <<PK>>
  --
  * university_id : VARCHAR(20) <<UK>>
  * email : VARCHAR(255) <<UK>>
  * password_hash : VARCHAR(100)
  * role : VARCHAR(20)
}

entity students {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK, UK>>
  * full_name : VARCHAR(150)
}

entity teachers {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK, UK>>
  * full_name : VARCHAR(150)
}

entity courses {
  * id : BIGINT <<PK>>
  --
  * course_code : VARCHAR(20) <<UK>>
  * title : VARCHAR(255)
  * weekly_hours : INT
}

entity sections {
  * id : BIGINT <<PK>>
  --
  * course_id : BIGINT <<FK>>
  * section_number : INT
  * capacity : INT
  * status : VARCHAR(20)
}

entity rooms {
  * id : BIGINT <<PK>>
  --
  * room_number : VARCHAR(20)
  * building : VARCHAR(100)
  * floor : INT
  * capacity : INT
  * is_available : BOOLEAN
}

entity time_slots {
  * id : BIGINT <<PK>>
  --
  * day_of_week : VARCHAR(10)
  * start_time : TIME
  * end_time : TIME
}

entity schedules {
  * id : BIGINT <<PK>>
  --
  * section_id : BIGINT <<FK>>
  * room_id : BIGINT <<FK>>
  * teacher_id : BIGINT <<FK>>
  * time_slot_id : BIGINT <<FK>>
  * status : VARCHAR(20)
}

entity registrations {
  * id : BIGINT <<PK>>
  --
  * student_id : BIGINT <<FK>>
  * section_id : BIGINT <<FK>>
  * course_id : BIGINT <<FK>>
  * registered_at : DATETIME
}

entity teacher_qualifications {
  * id : BIGINT <<PK>>
  --
  * teacher_id : BIGINT <<FK>>
  * course_id : BIGINT <<FK>>
}

entity teacher_preferences {
  * id : BIGINT <<PK>>
  --
  * teacher_id : BIGINT <<FK>>
  * course_id : BIGINT <<FK>>
  * priority : INT
}

entity teacher_availabilities {
  * id : BIGINT <<PK>>
  --
  * teacher_id : BIGINT <<FK>>
  * time_slot_id : BIGINT <<FK>>
  * is_available : BOOLEAN
}

entity teacher_swap_requests {
  * id : BIGINT <<PK>>
  --
  * requesting_teacher_id : BIGINT <<FK>>
  requesting_schedule_id : BIGINT <<FK>>
  * target_teacher_id : BIGINT <<FK>>
  target_schedule_id : BIGINT <<FK>>
  * status : VARCHAR(20)
  * created_at : DATETIME
  responded_at : DATETIME
  reviewed_at : DATETIME
}

entity notifications {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK>>
  * title : VARCHAR(200)
  * message : TEXT
  * type : VARCHAR(40)
  * is_read : BOOLEAN
  * created_at : DATETIME
}

entity academic_events {
  * id : BIGINT <<PK>>
  --
  * event_name : VARCHAR(200)
  * event_type : VARCHAR(30)
  * start_date : DATE
  * end_date : DATE
}

entity public_holidays {
  * id : BIGINT <<PK>>
  --
  * holiday_date : DATE
  * name : VARCHAR(200)
  description : VARCHAR(500)
}

' ---------- Relationships (with ON DELETE rule) ----------
users ||--o| students : has profile (CASCADE)
users ||--o| teachers : has profile (CASCADE)
users ||--o{ notifications : receives (CASCADE)

courses ||--o{ sections : has (RESTRICT)
rooms ||--o{ schedules : takes place in (RESTRICT)

sections ||--o{ schedules : has (CASCADE)
teachers ||--o{ schedules : teaches (RESTRICT)
time_slots ||--o{ schedules : at (RESTRICT)

students ||--o{ registrations : makes (RESTRICT)
sections ||--o{ registrations : has (RESTRICT)
courses ||--o{ registrations : copied from section (RESTRICT)

teachers ||--o{ teacher_qualifications : has (CASCADE)
courses ||--o{ teacher_qualifications : qualifies (CASCADE)

teachers ||--o{ teacher_preferences : has (CASCADE)
courses ||--o{ teacher_preferences : preferred (CASCADE)

teachers ||--o{ teacher_availabilities : declares (CASCADE)
time_slots ||--o{ teacher_availabilities : at (CASCADE)

teachers ||--o{ teacher_swap_requests : requesting teacher (RESTRICT, snapshot)
teachers ||--o{ teacher_swap_requests : target teacher (RESTRICT, snapshot)
schedules ||--o{ teacher_swap_requests : requesting schedule (SET NULL)
schedules ||--o{ teacher_swap_requests : target schedule (SET NULL)

' ---------- Notes: composite UNIQUE / INDEX ----------
note top of users
  Admin has no separate table;
  role = ADMIN is a users row.
end note

note bottom of sections
  UNIQUE (course_id, section_number)
end note

note bottom of rooms
  UNIQUE (building, room_number)
end note

note bottom of time_slots
  UNIQUE (day_of_week, start_time, end_time)
  CHECK end_time > start_time
end note

note bottom of schedules
  One row = one class period.
  status: DRAFT or PUBLISHED.
  UNIQUE (section_id, time_slot_id)
  INDEX (status, section_id)
end note

note bottom of registrations
  course_id is copied from the section's course.
  UNIQUE (student_id, section_id)
  UNIQUE (student_id, course_id)
end note

note bottom of teacher_qualifications
  UNIQUE (teacher_id, course_id)
end note

note bottom of teacher_preferences
  UNIQUE (teacher_id, course_id)
end note

note bottom of teacher_availabilities
  UNIQUE (teacher_id, time_slot_id)
end note

note bottom of teacher_swap_requests
  Refers to both schedules directly (SET NULL on delete).
  requesting_teacher_id & target_teacher_id
  are immutable point-in-time snapshots for audit trail.
  status: PENDING, ACCEPTED, REJECTED,
  APPROVED, CANCELLED.
  INDEX (status)
end note

note bottom of notifications
  INDEX (user_id, is_read, created_at)
end note

note bottom of academic_events
  No Foreign Keys.
  INDEX (event_type, start_date, end_date)
end note

note bottom of public_holidays
  No Foreign Keys.
  UNIQUE (holiday_date, name)
end note

@enduml
