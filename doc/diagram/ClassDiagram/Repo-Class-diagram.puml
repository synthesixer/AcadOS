' =====================================================================
' 0. Spring Data JPA Framework Base
' =====================================================================
package "org.springframework.data.jpa.repository" {
  interface "JpaRepository<T, ID>" as JpaRepository {
    + findAll(): List<T>
    + findById(id: ID): Optional<T>
    + save(entity: T): T
    + delete(entity: T): void
    + deleteById(id: ID): void
    + count(): long
    + existsById(id: ID): boolean
  }
}

' =====================================================================
' 1. Domain Entities (Managed Target Entities · 16 Entities)
' =====================================================================
package "domain.entity" {
  class User
  class Student
  class Teacher
  class Course
  class Section
  class Room
  class TimeSlot
  class Schedule
  class Registration
  class TeacherQualification
  class TeacherPreference
  class TeacherAvailability
  class TeacherSwapRequest
  class Notification
  class AcademicEvent
  class PublicHoliday
}

' =====================================================================
' 2. Repository Layer (§7 repository · 16 Repositories)
' =====================================================================
package "repository" <<Repository>> {
  interface UserRepository {
    + findByUniversityId(universityId: String): Optional<User>
    + findByEmail(email: String): Optional<User>
    + existsByUniversityId(universityId: String): boolean
    + existsByEmail(email: String): boolean
  }

  interface StudentRepository {
    + findByUser(user: User): Optional<Student>
    + findByUserId(userId: Long): Optional<Student>
    + findByFullNameContainingIgnoreCase(keyword: String): List<Student>
  }

  interface TeacherRepository {
    + findByUser(user: User): Optional<Teacher>
    + findByUserId(userId: Long): Optional<Teacher>
    + findByFullNameContainingIgnoreCase(keyword: String): List<Teacher>
  }

  interface CourseRepository {
    + findByCourseCode(courseCode: String): Optional<Course>
    + existsByCourseCode(courseCode: String): boolean
  }

  interface SectionRepository {
    + findByCourseId(courseId: Long): List<Section>
    + findByCourseIdAndSectionNumber(courseId: Long, sectionNumber: int): Optional<Section>
    + findByStatus(status: SectionStatus): List<Section>
  }

  interface RoomRepository {
    + findByRoomNumber(roomNumber: String): Optional<Room>
    + findByCapacityGreaterThanEqual(capacity: int): List<Room>
  }

  interface TimeSlotRepository {
    + findByDayOfWeek(dayOfWeek: DayOfWeek): List<TimeSlot>
  }

  interface ScheduleRepository {
    + findByStatus(status: ScheduleStatus): List<Schedule>
    + findBySectionId(sectionId: Long): List<Schedule>
    + findByTeacherId(teacherId: Long): List<Schedule>
    + findByRoomId(roomId: Long): List<Schedule>
    + deleteByStatus(status: ScheduleStatus): void
  }

  interface RegistrationRepository {
    + countBySectionId(sectionId: Long): long
    + existsByStudentIdAndCourseId(studentId: Long, courseId: Long): boolean
    + existsByStudentId(studentId: Long): boolean
    + findByStudentId(studentId: Long): List<Registration>
    + findBySectionId(sectionId: Long): List<Registration>
    + deleteBySectionId(sectionId: Long): void
  }

  interface TeacherQualificationRepository {
    + findByTeacherId(teacherId: Long): List<TeacherQualification>
    + findByCourseId(courseId: Long): List<TeacherQualification>
    + existsByTeacherIdAndCourseId(teacherId: Long, courseId: Long): boolean
    + deleteByTeacherIdAndCourseId(teacherId: Long, courseId: Long): void
  }

  interface TeacherPreferenceRepository {
    + findByTeacherId(teacherId: Long): List<TeacherPreference>
    + findByCourseId(courseId: Long): List<TeacherPreference>
    + deleteByTeacherIdAndCourseId(teacherId: Long, courseId: Long): void
  }

  interface TeacherAvailabilityRepository {
    + findByTeacherId(teacherId: Long): List<TeacherAvailability>
    + findByTeacherIdAndTimeSlotId(teacherId: Long, timeSlotId: Long): Optional<TeacherAvailability>
  }

  interface TeacherSwapRequestRepository {
    + findByRequestingTeacherIdOrTargetTeacherId(teacherIdA: Long, teacherIdB: Long): List<TeacherSwapRequest>
    + findByStatus(status: SwapStatus): List<TeacherSwapRequest>
  }

  interface NotificationRepository {
    + findByUserIdOrderByCreatedAtDesc(userId: Long): List<Notification>
    + countByUserIdAndIsReadFalse(userId: Long): long
  }

  interface AcademicEventRepository {
    + findByEventType(type: AcademicEventType): List<AcademicEvent>
  }

  interface PublicHolidayRepository {
    + findByDate(date: LocalDate): Optional<PublicHoliday>
    + findByDateBetween(start: LocalDate, end: LocalDate): List<PublicHoliday>
  }
}

