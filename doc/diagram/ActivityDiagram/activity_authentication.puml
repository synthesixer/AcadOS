@startuml
skinparam backgroundColor #EEF2FF

' Authentication & Authorization Activity Diagram

start
:User opens login page;
:User enters University ID & Password;
partition "Auth Service" {
    :AuthApiController receives POST /login;
    :Validate credentials via UserRepository;
    if (credentials valid?) then (yes)
        :Generate JWT (role embedded);
        :Return JWT to User;
    else (no)
        :Return 401 Unauthorized;
        stop
    endif
}
:User stores JWT for subsequent requests;

partition "Subsequent Requests (Security Filter)" {
    :User accesses protected resource with JWT;
    if (JWT missing, invalid, or expired?) then (yes)
        :Return 401 Unauthorized (Redirect to Login);
        stop
    elseif (Role does not match endpoint authority?) then (yes)
        :Return 403 Forbidden (Show Neutral Error 403 Page);
        stop
    else (authorized)
        :Proceed to Controller & Business Logic;
    endif
}
stop
@enduml